
@model List<ExpenseManagement.Web.Models.Expense>

@{
    ViewData["Title"] = "Expense Claims";

    var pendingCount = Model.Count(x => x.Status == "Pending");
    var approvedCount = Model.Count(x => x.Status == "Approved");
    var paidCount = Model.Count(x => x.Status == "Paid");
    var rejectedCount = Model.Count(x => x.Status == "Rejected");
}

<style>
    .claims-page {
        padding: 24px 0 36px;
        color: #18243b;
    }

    .claims-hero {
        background: linear-gradient(120deg, #172554, #3456b4);
        color: white;
        padding: 28px;
        border-radius: 18px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(23, 37, 84, .14);
    }

    .claims-hero h1 {
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .claims-hero p {
        color: #dbe5ff;
        margin-bottom: 0;
    }

    .create-claim-btn {
        display: inline-block;
        background: white;
        color: #263f86;
        text-decoration: none;
        font-weight: 700;
        padding: 12px 17px;
        border-radius: 10px;
        white-space: nowrap;
    }

    .create-claim-btn:hover {
        background: #edf2ff;
        color: #172554;
    }

    .claim-stat {
        height: 100%;
        background: white;
        border: 1px solid #e9edf5;
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 4px 14px rgba(23, 37, 84, .04);
        transition: transform .2s ease;
    }

    .claim-stat:hover {
        transform: translateY(-3px);
    }

    .claim-stat-label {
        font-size: 13px;
        color: #718096;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .claim-stat-value {
        font-size: 27px;
        font-weight: 800;
        margin: 0;
    }

    .stat-blue { color: #4361ee; }
    .stat-amber { color: #b77908; }
    .stat-green { color: #15803d; }
    .stat-cyan { color: #087e8b; }
    .stat-red { color: #be123c; }

    .claims-panel {
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(23, 37, 84, .05);
        margin-top: 26px;
    }

    .claims-panel-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f6;
    }

    .claims-panel-heading h2 {
        font-size: 19px;
        font-weight: 800;
        margin: 0 0 5px;
    }

    .claims-panel-heading p {
        color: #8792a6;
        font-size: 13px;
        margin: 0;
    }

    .claims-count {
        background: #edf2ff;
        color: #3455b4;
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 800;
    }

    /* Search and filters */
    .claims-filters {
        display: grid;
        grid-template-columns: minmax(220px, 2fr) repeat(2, minmax(160px, 1fr));
        gap: 15px;
        padding: 22px 24px;
        background: #fbfcff;
        border-bottom: 1px solid #edf0f6;
    }

    .filter-field label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: #53627b;
        margin-bottom: 8px;
    }

    .filter-control {
        width: 100%;
        min-height: 44px;
        border: 1px solid #dbe2ed;
        border-radius: 9px;
        padding: 10px 12px;
        background: white;
        color: #26334a;
        font-size: 13px;
        outline: none;
    }

    .filter-control:focus {
        border-color: #4361ee;
        box-shadow: 0 0 0 3px rgba(67, 97, 238, .10);
    }

    .filter-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 12px 24px;
        border-bottom: 1px solid #edf0f6;
    }

    .filter-result {
        color: #64748b;
        font-size: 12px;
    }

    .reset-filter-btn {
        border: 1px solid #dbe2ed;
        background: white;
        color: #3455b4;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .reset-filter-btn:hover {
        background: #edf2ff;
    }

    .claims-table {
        margin: 0;
        font-size: 13px;
        min-width: 1100px;
    }

    .claims-table thead th {
        background: #f8faff;
        color: #738098;
        font-size: 11px;
        letter-spacing: .6px;
        text-transform: uppercase;
        white-space: nowrap;
        padding: 15px 14px;
        border-bottom: 1px solid #e8edf5;
    }

    .claims-table tbody td {
        padding: 16px 14px;
        border-color: #eff2f7;
        vertical-align: middle;
    }

    .claims-table tbody tr:hover {
        background: #fafbff;
    }

    .claim-id {
        color: #3455b4;
        font-weight: 800;
        white-space: nowrap;
    }

    .employee-name {
        font-weight: 700;
        color: #26334a;
        min-width: 130px;
    }

    .employee-id-value {
        color: #465570;
        font-weight: 700;
        white-space: nowrap;
    }

    .category-label {
        background: #f0f3fa;
        color: #465570;
        border-radius: 6px;
        padding: 5px 8px;
        font-weight: 600;
        display: inline-block;
        white-space: nowrap;
    }

    .claim-amount {
        font-weight: 800;
        white-space: nowrap;
        color: #18243b;
    }

    .claim-date {
        white-space: nowrap;
        color: #5e6b81;
    }

    .claim-description {
        min-width: 180px;
        max-width: 260px;
        color: #5e6b81;
        overflow-wrap: anywhere;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-pill::before {
        content: "";
        width: 6px;
        height: 6px;
        background: currentColor;
        border-radius: 50%;
    }

    .status-pending { color: #986300; background: #fff3d6; }
    .status-approved { color: #187744; background: #e0f8e9; }
    .status-rejected { color: #b4233b; background: #ffe4e8; }
    .status-paid { color: #087e8b; background: #d9f5f7; }

    .action-form {
        display: inline-block;
        margin: 2px;
    }

    .action-btn {
        border: 0;
        border-radius: 7px;
        padding: 8px 10px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
        transition: .15s ease;
        cursor: pointer;
    }

    .action-btn:hover {
        transform: translateY(-1px);
        filter: brightness(.96);
    }

    .approve-btn { background: #dcfce7; color: #166534; }
    .reject-btn { background: #ffe4e6; color: #be123c; }
    .paid-btn { background: #e0e7ff; color: #3730a3; }

    .no-action {
        color: #9aa4b5;
        font-size: 12px;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px !important;
        color: #718096;
    }

    .empty-state strong {
        display: block;
        color: #26334a;
        font-size: 17px;
        margin-bottom: 7px;
    }

    .claims-footer {
        color: #8792a6;
        font-size: 12px;
        margin-top: 18px;
    }

    @@media (max-width: 768px) {
        .claims-filters {
            grid-template-columns: 1fr;
            padding: 18px;
        }

        .claims-panel-heading {
            padding: 18px;
        }
    }

    @@media (max-width: 576px) {
        .claims-hero {
            padding: 22px;
        }

        .claims-hero h1 {
            font-size: 25px;
        }

        .claims-hero .create-claim-btn {
            margin-top: 18px;
        }
    }
</style>

<div class="claims-page">

    <section class="claims-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1>Expense Claims</h1>
                <p>Manage reimbursement requests, review claims, and track payments.</p>
            </div>

            <a asp-controller="Expenses"
               asp-action="Create"
               class="create-claim-btn">
                + &nbsp; Create New Claim
            </a>
        </div>
    </section>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">
        <div class="col-6 col-lg">
            <div class="claim-stat">
                <div class="claim-stat-label">Total Claims</div>
                <p class="claim-stat-value stat-blue">@Model.Count</p>
            </div>
        </div>

        <div class="col-6 col-lg">
            <div class="claim-stat">
                <div class="claim-stat-label">Pending</div>
                <p class="claim-stat-value stat-amber">@pendingCount</p>
            </div>
        </div>

        <div class="col-6 col-lg">
            <div class="claim-stat">
                <div class="claim-stat-label">Approved</div>
                <p class="claim-stat-value stat-green">@approvedCount</p>
            </div>
        </div>

        <div class="col-6 col-lg">
            <div class="claim-stat">
                <div class="claim-stat-label">Rejected</div>
                <p class="claim-stat-value stat-red">@rejectedCount</p>
            </div>
        </div>

        <div class="col-6 col-lg">
            <div class="claim-stat">
                <div class="claim-stat-label">Paid</div>
                <p class="claim-stat-value stat-cyan">@paidCount</p>
            </div>
        </div>
    </div>

    <section class="claims-panel">

        <div class="claims-panel-heading">
            <div>
                <h2>All Reimbursement Requests</h2>
                <p>Search, filter, review employee claims, and update their status.</p>
            </div>

            <span class="claims-count">@Model.Count total records</span>
        </div>

        <!-- Search and filter controls -->
        <div class="claims-filters">

            <div class="filter-field">
                <label for="employeeSearch">Search Employee</label>
                <input type="search"
                       id="employeeSearch"
                       class="filter-control"
                       placeholder="Search by name or employee ID..."
                       autocomplete="off" />
            </div>

            <div class="filter-field">
                <label for="statusFilter">Filter by Status</label>
                <select id="statusFilter" class="filter-control">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                    <option value="Paid">Paid</option>
                </select>
            </div>

            <div class="filter-field">
                <label for="categoryFilter">Filter by Category</label>
                <select id="categoryFilter" class="filter-control">
                    <option value="">All Categories</option>
                    <option value="Travel">Travel</option>
                    <option value="Food">Food</option>
                    <option value="Accommodation">Accommodation</option>
                    <option value="Office Supplies">Office Supplies</option>
                    <option value="Other">Other</option>
                </select>
            </div>

        </div>

        <div class="filter-bottom">
            <span id="filterResult" class="filter-result" aria-live="polite">
                Showing @Model.Count of @Model.Count claims
            </span>

            <button type="button" id="resetFilters" class="reset-filter-btn">
                Reset Filters
            </button>
        </div>

        <div class="table-responsive">
            <table class="table claims-table">
                <thead>
                    <tr>
                        <th>Claim ID</th>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Expense Date</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="claimsTableBody">

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="empty-state">
                                <strong>No expense claims yet</strong>
                                Submit a new claim to see it listed here.

                                <div class="mt-3">
                                    <a asp-controller="Expenses"
                                       asp-action="Create"
                                       class="btn btn-primary btn-sm">
                                        Create First Claim
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var expense in Model)
                        {
                            <tr class="claim-row"
                                data-employee-name="@expense.EmployeeName"
                                data-employee-id="@expense.EmployeeId"
                                data-status="@expense.Status"
                                data-category="@expense.Category">

                                <td class="claim-id">#@expense.ClaimId</td>

                                <td class="employee-id-value">
                                    @expense.EmployeeId
                                </td>

                                <td>
                                    <div class="employee-name">
                                        @expense.EmployeeName
                                    </div>
                                </td>

                                <td>
                                    <span class="category-label">
                                        @expense.Category
                                    </span>
                                </td>

                                <td class="claim-amount">
                                    ₹@expense.Amount.ToString("N2")
                                </td>

                                <td class="claim-date">
                                    @expense.ExpenseDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="claim-description">
                                    @expense.Description
                                </td>

                                <td>
                                    @if (expense.Status == "Approved")
                                    {
                                        <span class="status-pill status-approved">Approved</span>
                                    }
                                    else if (expense.Status == "Rejected")
                                    {
                                        <span class="status-pill status-rejected">Rejected</span>
                                    }
                                    else if (expense.Status == "Paid")
                                    {
                                        <span class="status-pill status-paid">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-pending">@expense.Status</span>
                                    }
                                </td>

                                <td>
                                    @if (expense.Status == "Pending")
                                    {
                                        <form asp-controller="Expenses"
                                              asp-action="UpdateStatus"
                                              method="post"
                                              class="action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@expense.ClaimId" />
                                            <input type="hidden" name="status" value="Approved" />
                                            <button type="submit" class="action-btn approve-btn">
                                                ✓ Approve
                                            </button>
                                        </form>

                                        <form asp-controller="Expenses"
                                              asp-action="UpdateStatus"
                                              method="post"
                                              class="action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@expense.ClaimId" />
                                            <input type="hidden" name="status" value="Rejected" />
                                            <button type="submit" class="action-btn reject-btn">
                                                × Reject
                                            </button>
                                        </form>
                                    }
                                    else if (expense.Status == "Approved")
                                    {
                                        <form asp-controller="Expenses"
                                              asp-action="UpdateStatus"
                                              method="post"
                                              class="action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@expense.ClaimId" />
                                            <input type="hidden" name="status" value="Paid" />
                                            <button type="submit" class="action-btn paid-btn">
                                                ₹ Mark Paid
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="no-action">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }

                    <tr id="noFilterResults" style="display: none;">
                        <td colspan="9" class="empty-state">
                            <strong>No matching claims found</strong>
                            Try a different employee name or change your filters.
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </section>

    <div class="claims-footer">
        Expense Reimbursement Management System · Claims and payment tracking
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const employeeSearch = document.getElementById("employeeSearch");
        const statusFilter = document.getElementById("statusFilter");
        const categoryFilter = document.getElementById("categoryFilter");
        const resetFilters = document.getElementById("resetFilters");
        const filterResult = document.getElementById("filterResult");
        const noFilterResults = document.getElementById("noFilterResults");

        const claimRows = Array.from(
            document.querySelectorAll("#claimsTableBody .claim-row")
        );

        const totalClaims = claimRows.length;

        function applyFilters() {
            const searchText = employeeSearch.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value.toLowerCase();
            const selectedCategory = categoryFilter.value.toLowerCase();

            let visibleCount = 0;

            claimRows.forEach(function (row) {
                const employeeName =
                    (row.dataset.employeeName || "").toLowerCase();

                const employeeId =
                    (row.dataset.employeeId || "").toLowerCase();

                const status =
                    (row.dataset.status || "").toLowerCase();

                const category =
                    (row.dataset.category || "").toLowerCase();

                const matchesEmployee =
                    employeeName.includes(searchText) ||
                    employeeId.includes(searchText);

                const matchesStatus =
                    selectedStatus === "" || status === selectedStatus;

                const matchesCategory =
                    selectedCategory === "" || category === selectedCategory;

                const shouldShow =
                    matchesEmployee && matchesStatus && matchesCategory;

                row.style.display = shouldShow ? "" : "none";

                if (shouldShow) {
                    visibleCount++;
                }
            });

            filterResult.textContent =
                "Showing " + visibleCount + " of " + totalClaims + " claims";

            noFilterResults.style.display =
                totalClaims > 0 && visibleCount === 0 ? "" : "none";
        }

        employeeSearch.addEventListener("input", applyFilters);
        statusFilter.addEventListener("change", applyFilters);
        categoryFilter.addEventListener("change", applyFilters);

        resetFilters.addEventListener("click", function () {
            employeeSearch.value = "";
            statusFilter.value = "";
            categoryFilter.value = "";
            applyFilters();
            employeeSearch.focus();
        });

        applyFilters();
    });
</script>
